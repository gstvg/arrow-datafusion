#############
## Array Expressions Tests
#############

statement ok
set datafusion.sql_parser.dialect = databricks;

statement ok
CREATE TABLE tt
AS VALUES
([1, 50], 10),
([4, 50], 40);

statement ok
CREATE TABLE t AS SELECT 1 as f, [ [ [2, 3], [2] ], [ [1] ], [ [] ] ] as v, 1 as n;

query I?
SELECT t.n, list_map([], e1 -> t.n) from t;
----
1 []

query ?
SELECT list_map([1], e1 -> (select n from t));
----
[1]

query ?
SELECT list_map(v, (v1, i) -> list_map(v1, (v2, j) -> list_map(v2, v3 -> j)) ) from t;
----
[[[0, 0], [1]], [[0]], [[]]]

query I?
SELECT t.n, list_map([1, 2], (e) -> n) from t;
----
1 [1, 1]

# selection pushdown not working yet
query ?
SELECT list_map([1, 2], (e) -> n) from t;
----
[1, 1]

query ?
SELECT list_map([1, 2], (e, i) -> i) from t;
----
[0, 1]

# type coercion
query ?
SELECT list_map([1, 2], (e, i) -> e+i) from t;
----
[1, 3]

query TT
EXPLAIN SELECT list_map([1, 2], (e, i) -> e+i);
----
logical_plan
01)Projection: list_map(List([1, 2]), (e, i) -> e + CAST(i AS Int64)) AS list_map(make_array(Int64(1),Int64(2)),(e, i) -> e + i)
02)--EmptyRelation
physical_plan
01)ProjectionExec: expr=[list_map([1, 2], lambda((e, i) -> e@0 + CAST(i@1 AS Int64))) as list_map(make_array(Int64(1),Int64(2)),(e, i) -> e + i)]
02)--PlaceholderRowExec

#cse
query TT
explain select n + 1, list_map([1], v -> v + n + 1) from t;
----
logical_plan
01)Projection: t.n + Int64(1), list_map(List([1]), (v) -> v + t.n + Int64(1)) AS list_map(make_array(Int64(1)),(v) -> v + t.n + Int64(1))
02)--TableScan: t projection=[n]
physical_plan
01)ProjectionExec: expr=[n@0 + 1 as t.n + Int64(1), list_map([1], lambda((v) -> v@0 + n@1 + 1)) as list_map(make_array(Int64(1)),(v) -> v + t.n + Int64(1))]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

query ?
SELECT list_map([1,2,3,4,5], v -> v*2);
----
[2, 4, 6, 8, 10]

query ?
SELECT list_map([1,2,3,4,5], v -> 2);
----
[2, 2, 2, 2, 2]

query ?
SELECT list_map([[1,2],[3,4,5]], v -> list_map(v, v -> v*2));
----
[[2, 4], [6, 8, 10]]

query ?
SELECT list_map([1,2,3,4,5], v -> repeat("a", v));
----
[a, aa, aaa, aaaa, aaaaa]

query ?
SELECT list_map([1,2,3,4,5], v -> list_repeat("a", v));
----
[[a], [a, a], [a, a, a], [a, a, a, a], [a, a, a, a, a]]

query TT
EXPLAIN SELECT list_map([1,2,3,4,5], v -> v*2);
----
logical_plan
01)Projection: list_map(List([1, 2, 3, 4, 5]), (v) -> v * Int64(2)) AS list_map(make_array(Int64(1),Int64(2),Int64(3),Int64(4),Int64(5)),(v) -> v * Int64(2))
02)--EmptyRelation
physical_plan
01)ProjectionExec: expr=[list_map([1, 2, 3, 4, 5], lambda((v) -> v@0 * 2)) as list_map(make_array(Int64(1),Int64(2),Int64(3),Int64(4),Int64(5)),(v) -> v * Int64(2))]
02)--PlaceholderRowExec


query I??
SELECT t.n, t.v, list_map(t.v, (v, i) -> list_map(v, (v, j) -> n) ) from t;
----
1 [[[2, 3], [2]], [[1]], [[]]] [[1, 1], [1], [1]]

query ?
SELECT list_map([1,2,3,4,5], v -> v*2);
----
[2, 4, 6, 8, 10]


query error DataFusion error: Execution error: list_map expects a value follewed by a lambda, got \[\]
select list_map();

query error DataFusion error: Execution error: expected list, got Int64
select list_map(1, v -> v*2);

query error DataFusion error: Execution error: list_map expects a value follewed by a lambda, got \[Lambda\(\["v"\]\), Value\(List\(Field \{ name: "item", data_type: Int64, nullable: true, dict_id: 0, dict_is_ordered: false, metadata: \{\} \}\)\)\]
select list_map(v -> v*2, [1, 2]);
